// ============================================================
// PRISM-X — Prisma schema (Backend Phase 1)
//
// Design rules:
//  * Every tenant-scoped model carries `organizationId` and is indexed on it.
//    This is the single anchor for both repository-level scoping and the
//    Postgres RLS policies in migrations/*_rls/migration.sql.
//  * No business logic lives here. Enums encode state machines only.
//  * Soft-delete (`deletedAt`) on entities users can remove but auditors
//    may still need to see.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Tenancy & identity
// ------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  plan      OrgPlan   @default(FREE)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships   Membership[]
  workers       Worker[]
  missions      Mission[]
  tasks         Task[]
  knowledge     Knowledge[]
  providers     Provider[]
  integrations  Integration[]
  extensions    Extension[]
  events        Event[]
  auditLogs     AuditLog[]
  credentials   Credential[]
  roles         Role[]
  memories      Memory[]
  executionLogs ExecutionLog[]
  toolCalls     ToolCall[]
  usageDaily    UsageDaily[]

  // Phase 3
  workflows         Workflow[]
  workflowVersions  WorkflowVersion[]
  workflowRuns      WorkflowRun[]
  workflowStepRuns  WorkflowStepRun[]
  triggers          Trigger[]
  approvals         ApprovalRequest[]
  notifications     Notification[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  deadLetters       DeadLetter[]

  // Phase 4
  nodes            Node[]
  nodeCapabilities NodeCapability[]
  nodeHeartbeats   NodeHeartbeat[]
  nodeKeys         NodeKey[]
  distributedTasks DistributedTask[]
  memoryShards     MemoryShard[]
  memorySyncOps    MemorySyncOp[]
  nodeSyncStates   NodeSyncState[]
  /// Grants this organization issued to peers.
  federationGrants FederationGrant[] @relation("FederationOwner")
  /// Grants other organizations issued to this one.
  federationAccess FederationGrant[] @relation("FederationPeer")

  // Phase 5
  missionReviews       MissionReview[]
  performanceSnapshots PerformanceSnapshot[]
  recommendations      Recommendation[]
  workerProfiles       WorkerProfile[]
  detectedPatterns     DetectedPattern[]
  learningEntries      LearningEntry[]
  knowledgeAudits      KnowledgeAudit[]
  experiments          Experiment[]

  // Phase 6
  evolutionCandidates    EvolutionCandidate[]
  evolutionExperiments   EvolutionExperiment[]
  benchmarks             Benchmark[]
  entityVersions         EntityVersion[]
  deployments            Deployment[]
  evolutionPolicy        EvolutionPolicy?
  constitutionViolations ConstitutionViolation[]
  planningStrategies     PlanningStrategy[]

  // Phase 7
  extensionLifecycle     ExtensionLifecycleEvent[]
  extensionContributions ExtensionContribution[]
  extensionState         ExtensionState[]
  extensionHostCalls     ExtensionHostCall[]
  extensionUpgrades      ExtensionUpgrade[]
  marketplaceReviews     MarketplaceReview[]
  developerApps          DeveloperApp[]
  developerApiUsage      DeveloperApiUsage[]
  /// Publisher identities this organization owns.
  publishers             Publisher[]
  subscription           Subscription?
  invoices               Invoice[]
  userSessions           UserSession[]
  ipAllowEntries         IpAllowEntry[]
  complianceReports      ComplianceReport[]

  @@index([deletedAt])
  @@map("organizations")
}

/// A user is global (one identity across orgs); org access is via Membership.
/// `supabaseUserId` links to Supabase Auth when that provider is active;
/// `passwordHash` backs the local auth provider used in dev/test.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  displayName    String?
  avatarUrl      String?
  supabaseUserId String?   @unique
  passwordHash   String?
  emailVerified  Boolean   @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  memberships Membership[]
  auditLogs   AuditLog[]

  @@index([supabaseUserId])
  @@map("users")
}

/// Join table binding a User into an Organization with exactly one Role.
model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

// ------------------------------------------------------------
// RBAC
// ------------------------------------------------------------

/// System roles have `organizationId = null` and are seeded once
/// (OWNER/ADMIN/OPERATOR/VIEWER). Orgs may define additional custom roles.
model Role {
  id             String   @id @default(cuid())
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]

  @@unique([key, organizationId])
  @@index([organizationId])
  @@map("roles")
}

/// Permissions are global constants shaped `resource:action`
/// (e.g. `mission:create`). Seeded, never user-created.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------
// Intelligence core
// ------------------------------------------------------------

model Worker {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  role           String
  status         WorkerStatus @default(DORMANT)
  dna            Json         @default("{}")
  capabilities   String[]     @default([])
  providerId     String?
  generation     Int          @default(1)
  fitness        Float        @default(0)

  // --- Phase 2: executable worker identity -------------------------
  /// Prepended to every execution. The worker's standing instructions.
  systemPrompt    String?
  /// Human-readable competencies, surfaced to the planner.
  skills          String[] @default([])
  /// Overrides the provider's default model when set.
  defaultModel    String?
  temperature     Float    @default(0.7)
  /// Tool keys this worker may invoke. Empty means no tool access.
  toolPermissions String[] @default([])

  // Execution limits — the guardrails that stop a runaway worker from
  // looping forever or spending without bound.
  maxIterations Int     @default(5)
  maxTokens     Int     @default(4096)
  timeoutMs     Int     @default(120000)
  costLimitUsd  Float?
  /// When false, a failure on this worker's provider is not silently retried
  /// on a different one — used to pin a worker to a specific provider.
  allowFailover Boolean @default(true)

  // --- Phase 4: placement -------------------------------------------
  /// Pins execution to one node. Null lets the scheduler choose, which is
  /// the normal case — placement is an infrastructure concern, not part of
  /// a worker's identity.
  preferredNodeId  String?
  /// Constraints the scheduler must satisfy, e.g.
  /// `{ "requiresGpu": true, "minMemoryMb": 8192, "labels": ["eu"] }`.
  nodeRequirements Json    @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider      Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  tasks         Task[]
  knowledge     Knowledge[]
  memories      Memory[]
  executionLogs ExecutionLog[]
  profile       WorkerProfile?

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("workers")
}

model Mission {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  objective      String
  status         MissionStatus @default(DRAFT)
  priority       Priority      @default(MEDIUM)
  progress       Int           @default(0)
  metadata       Json          @default("{}")
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // --- Phase 2: execution bookkeeping ------------------------------
  /// Plan produced by the planning phase: ordered steps and rationale.
  plan         Json?
  /// Why the mission is WAITING, when it is.
  waitReason   String?
  retryCount   Int       @default(0)
  maxRetries   Int       @default(2)
  /// Rolled up from this mission's execution logs.
  totalCostUsd Float     @default(0)
  totalTokens  Int       @default(0)
  archivedAt   DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks         Task[]
  executionLogs ExecutionLog[]
  review        MissionReview?

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("missions")
}

/// A unit of work inside a Mission. `dependsOn` holds sibling task ids,
/// forming the mission DAG resolved by the queue layer.
model Task {
  id             String     @id @default(cuid())
  organizationId String
  missionId      String
  workerId       String?
  title          String
  description    String?
  status         TaskStatus @default(PENDING)
  priority       Priority   @default(MEDIUM)
  dependsOn      String[]   @default([])
  result         Json?
  error          String?
  attempts       Int        @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // --- Phase 2: orchestration + accounting -------------------------
  /// Set by the planner before execution; compared against actuals.
  estimatedCostUsd Float?
  estimatedSeconds Int?
  /// The worker's final answer, kept separate from structured `result`.
  output           String?
  costUsd          Float     @default(0)
  tokensUsed       Int       @default(0)
  maxRetries       Int       @default(2)
  /// When a retry becomes eligible, for exponential backoff.
  nextAttemptAt    DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission       Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  worker        Worker?        @relation(fields: [workerId], references: [id], onDelete: SetNull)
  executionLogs ExecutionLog[]

  @@index([organizationId])
  @@index([missionId])
  @@index([organizationId, status])
  @@map("tasks")
}

model Knowledge {
  id             String        @id @default(cuid())
  organizationId String
  workerId       String?
  title          String
  content        String
  type           KnowledgeType @default(NOTE)
  tags           String[]      @default([])
  source         String?
  storagePath    String?
  confidence     Float         @default(1)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker       Worker?          @relation(fields: [workerId], references: [id], onDelete: SetNull)
  audits       KnowledgeAudit[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@map("knowledge")
}

// ------------------------------------------------------------
// External surface: providers, integrations, extensions
// ------------------------------------------------------------

/// An AI provider *registration*. Phase 1 stores configuration only —
/// no vendor SDK is wired. `kind` selects the adapter at resolve time.
model Provider {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  kind           ProviderKind
  status         ProviderStatus @default(DISCONNECTED)
  config         Json           @default("{}")
  credentialId   String?        @unique
  isDefault      Boolean        @default(false)
  lastCheckedAt  DateTime?

  // --- Phase 2: model catalogue + limits ---------------------------
  /// Models this provider is permitted to serve. Empty means "adapter default".
  models       String[] @default([])
  defaultModel String?

  /// Requests and tokens per minute. Null means unlimited (the adapter or the
  /// vendor still enforces its own ceiling).
  rateLimitRpm Int?
  rateLimitTpm Int?

  // Rolling health + usage, updated by the Provider Manager.
  avgLatencyMs   Int?
  totalRequests  Int       @default(0)
  failedRequests Int       @default(0)
  totalTokens    Int       @default(0)
  totalCostUsd   Float     @default(0)
  lastErrorAt    DateTime?
  lastError      String?
  /// Set when the circuit breaker opens; requests are refused until it passes.
  cooldownUntil  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential    Credential?    @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  workers       Worker[]
  executionLogs ExecutionLog[]

  @@index([organizationId])
  @@map("providers")
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  kind           String
  status         IntegrationStatus @default(INACTIVE)
  config         Json              @default("{}")
  credentialId   String?
  lastSyncAt     DateTime?

  // --- Phase 3: connector metadata ---------------------------------
  /// Broad service category, for grouping and for policy.
  category    IntegrationCategory @default(CUSTOM_API)
  /// How this integration authenticates: api_key | bearer | basic | oauth2 | none.
  authMethod  String              @default("api_key")
  /// Operations this integration is permitted to perform, e.g. ["send","read"].
  /// Empty means the connector's own default set.
  permissions String[]            @default([])

  // Health and usage, updated by the Integration Manager.
  healthy       Boolean   @default(false)
  lastHealthAt  DateTime?
  lastError     String?
  callCount     Int       @default(0)
  failureCount  Int       @default(0)
  avgLatencyMs  Int?
  /// Set when the circuit breaker trips; calls are refused until it passes.
  cooldownUntil DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("integrations")
}

model Extension {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  slug           String
  version        String          @default("1.0.0")
  status         ExtensionStatus @default(INSTALLED)
  manifest       Json            @default("{}")
  subscribes     String[]        @default([])

  // ---------------------------------------------------------- Phase 7
  description String?
  author      String?
  publisherId String?
  license     String?
  homepage    String?

  /// What the manifest asked for. Kept alongside what was granted so the gap
  /// between the two is visible without recomputing it.
  requestedCapabilities String[]            @default([])
  /// What the extension actually holds: requested ∩ the installer's own
  /// permissions. Never larger than `requestedCapabilities`.
  capabilities          String[]            @default([])
  /// `[{ capability, missing: [permission] }]` — why each gap exists.
  withheldCapabilities  Json                @default("[]")
  /// Capability-catalogue fingerprint at the moment of the grant. A change
  /// here means the meaning of a granted capability may have moved, which
  /// re-opens consent rather than silently carrying forward.
  capabilityVersion     String              @default("")
  riskLevel             CapabilityRiskLevel @default(LOW)

  /// Operator-supplied settings the manifest declared. Non-secret only.
  config  Json @default("{}")
  /// Sealed values for `secret` config fields. Never returned by any endpoint.
  secrets Json @default("{}")
  /// Resolved sandbox ceiling, clamped to the platform maximum at install.
  limits  Json @default("{}")

  engine            String?
  dependencies      Json    @default("{}")
  /// sha256 over the security-relevant manifest fields — what a signature attests.
  manifestDigest    String  @default("")
  signature         String?
  signatureVerified Boolean @default(false)

  /// The marketplace listing this was installed from, when it came from one.
  listingId      String?
  installedById  String?
  /// Set while an upgrade is waiting on fresh consent for new capabilities.
  pendingVersion String?
  lastError      String?
  initializedAt  DateTime?
  lastRunAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publisher     Publisher?                @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  listing       MarketplaceListing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  lifecycle     ExtensionLifecycleEvent[]
  contributions ExtensionContribution[]
  state         ExtensionState[]
  hostCalls     ExtensionHostCall[]
  upgrades      ExtensionUpgrade[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([listingId])
  @@map("extensions")
}

// ------------------------------------------------------------
// Observability: events, audit, credentials
// ------------------------------------------------------------

/// Durable record of every domain event published on the bus.
/// Subscribers (extensions, analytics) replay from here.
model Event {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  payload        Json     @default("{}")
  actorId        String?
  correlationId  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([createdAt])
  @@map("events")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  ip             String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, resource])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Encrypted secret material (API keys, tokens). `value` is ciphertext
/// produced by the CryptoService — plaintext never reaches the database.
model Credential {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  type           String
  value          String
  iv             String
  authTag        String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     Provider?

  @@index([organizationId])
  @@map("credentials")
}

// ------------------------------------------------------------
// Phase 2: memory, execution telemetry, usage
// ------------------------------------------------------------

/// Persistent worker memory.
///
/// SHORT_TERM entries carry an `expiresAt` and describe the current
/// conversation or execution; LONG_TERM entries persist and describe learned
/// strategies, preferences and outcomes. Retrieval ranks by importance,
/// recency and keyword overlap — `embedding` is reserved for the semantic
/// upgrade and is unused while retrieval is keyword-based.
model Memory {
  id             String     @id @default(cuid())
  organizationId String
  workerId       String
  type           MemoryType @default(SHORT_TERM)
  content        String
  /// Free-form label, e.g. "mission:clx…" or "preference".
  category       String?
  tags           String[]   @default([])
  /// 0..1. Drives retrieval ranking and what survives consolidation.
  importance     Float      @default(0.5)
  /// Provenance: mission/task that produced this memory.
  missionId      String?
  taskId         String?
  metadata       Json       @default("{}")
  embedding      Float[]    @default([])
  accessCount    Int        @default(0)
  lastAccessedAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker       Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workerId, type])
  @@index([organizationId, expiresAt])
  @@map("memories")
}

/// One row per AI call. The audit trail for what was asked, what came back,
/// what it cost and how long it took.
model ExecutionLog {
  id             String          @id @default(cuid())
  organizationId String
  workerId       String?
  missionId      String?
  taskId         String?
  providerId     String?
  providerKind   ProviderKind?
  model          String?
  status         ExecutionStatus @default(RUNNING)

  /// Truncated at the edge — full prompts can be enormous and are not needed
  /// for audit, only for diagnosis.
  prompt           String?
  outputSummary    String?
  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)
  totalTokens      Int     @default(0)
  costUsd          Float   @default(0)
  latencyMs        Int     @default(0)
  /// How many provider attempts this execution consumed (retries included).
  attempts         Int     @default(1)
  error            String?
  metadata         Json    @default("{}")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker       Worker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)
  mission      Mission?     @relation(fields: [missionId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  provider     Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  toolCalls    ToolCall[]

  @@index([organizationId])
  @@index([organizationId, startedAt])
  @@index([missionId])
  @@index([workerId])
  @@map("execution_logs")
}

/// A single tool invocation made during an execution.
model ToolCall {
  id             String     @id @default(cuid())
  organizationId String
  executionLogId String?
  workerId       String?
  tool           String
  input          Json       @default("{}")
  output         Json?
  status         ToolStatus @default(SUCCESS)
  error          String?
  /// Set when a worker asked for a tool its permissions do not cover.
  denied         Boolean    @default(false)
  durationMs     Int        @default(0)
  createdAt      DateTime   @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executionLog ExecutionLog? @relation(fields: [executionLogId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, tool])
  @@map("tool_calls")
}

/// Daily usage rollup.
///
/// Execution logs are the source of truth; this table exists so a dashboard
/// covering months of history does not have to scan every call. Rows are
/// upserted as executions complete.
model UsageDaily {
  id             String   @id @default(cuid())
  organizationId String
  /// Midnight UTC of the day being summarised.
  day            DateTime @db.Date

  /// Slice keys. Empty string — not NULL — for "not applicable", because
  /// Postgres treats NULLs as distinct in a unique index: a nullable slice key
  /// would make the constraint below stop deduplicating and the rollup would
  /// grow a new row per execution instead of accumulating.
  providerId   String        @default("")
  model        String        @default("")
  workerId     String        @default("")
  providerKind ProviderKind?

  requests         Int   @default(0)
  failedRequests   Int   @default(0)
  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  totalTokens      Int   @default(0)
  costUsd          Float @default(0)
  /// Sum of latencies; divide by `requests` for the mean.
  latencyMsTotal   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day, providerId, model, workerId], name: "usage_daily_slice")
  @@index([organizationId, day])
  @@map("usage_daily")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum MemoryType {
  SHORT_TERM
  LONG_TERM
}

enum ExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  TIMEOUT
  CANCELLED
  BUDGET_EXCEEDED
}

enum ToolStatus {
  SUCCESS
  FAILED
  DENIED
}

enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WorkerStatus {
  DORMANT
  ACTIVE
  LEARNING
  NEEDS_ATTENTION
  ARCHIVED
}

enum MissionStatus {
  DRAFT
  QUEUED
  /// Decomposing the objective into a task graph.
  PLANNING
  RUNNING
  PAUSED
  /// Blocked on something outside the engine (input, rate limit, dependency).
  WAITING
  COMPLETED
  FAILED
  CANCELLED
  ARCHIVED
}

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KnowledgeType {
  NOTE
  DOCUMENT
  INSIGHT
  PATTERN
  ARTIFACT
}

enum ProviderKind {
  OPENAI
  ANTHROPIC
  GEMINI
  HERMES
  OLLAMA
  /// Deterministic in-process adapter. No network, no key — used for
  /// development, CI and end-to-end verification of the execution pipeline.
  LOCAL
  /// Any OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter, …).
  CUSTOM
}

enum ProviderStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum IntegrationStatus {
  INACTIVE
  ACTIVE
  ERROR
}

enum ExtensionStatus {
  INSTALLED
  ENABLED
  DISABLED
  /// Requests capabilities that need a human decision before they are granted.
  PENDING_REVIEW
  /// Installed, but initialization or a migration failed. Inert until repaired.
  FAILED
  /// Stopped by governance — a security advisory, a suspended publisher, a
  /// signature that no longer verifies. Distinct from DISABLED, which is the
  /// operator's own choice.
  QUARANTINED
}

// ============================================================
// Phase 3 — Automation & Integration Platform
// ============================================================

/// A workflow definition. The mutable head; executable content lives in
/// versions so a running instance is never changed underneath itself.
model Workflow {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  status          WorkflowStatus @default(DRAFT)
  /// Points at the version new runs will use.
  activeVersionId String?        @unique
  /// Marks this as a reusable template rather than an operational workflow.
  isTemplate      Boolean        @default(false)
  category        String?
  tags            String[]       @default([])

  // Reliability envelope applied to every run.
  maxConcurrentRuns Int @default(5)
  timeoutMs         Int @default(300000)
  maxRetries        Int @default(2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions      WorkflowVersion[] @relation("workflow_versions")
  activeVersion WorkflowVersion?  @relation("active_version", fields: [activeVersionId], references: [id], onDelete: SetNull)
  runs          WorkflowRun[]
  triggers      Trigger[]
  experiments   Experiment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("workflows")
}

/// An immutable snapshot of a workflow's steps.
///
/// Editing a published workflow creates a new version rather than mutating the
/// old one: a run in flight must keep executing the definition it started with,
/// and an audit needs to show what actually ran.
model WorkflowVersion {
  id             String    @id @default(cuid())
  organizationId String
  workflowId     String
  version        Int
  /// Ordered step graph. Shape validated by the engine, not the database.
  steps          Json      @default("[]")
  /// Declared inputs with defaults, used to validate a run's payload.
  inputSchema    Json      @default("{}")
  notes          String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow      @relation("workflow_versions", fields: [workflowId], references: [id], onDelete: Cascade)
  activeFor    Workflow?     @relation("active_version")
  runs         WorkflowRun[]

  @@unique([workflowId, version])
  @@index([organizationId])
  @@map("workflow_versions")
}

/// One execution of one workflow version.
model WorkflowRun {
  id             String            @id @default(cuid())
  organizationId String
  workflowId     String
  versionId      String
  status         WorkflowRunStatus @default(PENDING)
  /// How this run was started.
  triggerType    TriggerType       @default(MANUAL)
  triggerId      String?
  input          Json              @default("{}")
  /// Accumulated step outputs, keyed by step id — the run's working memory.
  context        Json              @default("{}")
  output         Json?
  error          String?

  /// Set while suspended awaiting a human decision.
  awaitingApprovalId String?
  currentStepId      String?

  attempts       Int     @default(1)
  /// Caller-supplied key; a repeat within the dedupe window returns this run
  /// instead of starting another.
  idempotencyKey String?

  costUsd     Float @default(0)
  totalTokens Int   @default(0)
  durationMs  Int   @default(0)
  stepsTotal  Int   @default(0)
  stepsRun    Int   @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  resumedAt  DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version      WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  stepRuns     WorkflowStepRun[]
  approvals    ApprovalRequest[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([workflowId])
  @@map("workflow_runs")
}

/// One step within one run. The unit of retry and the unit of audit.
model WorkflowStepRun {
  id             String            @id @default(cuid())
  organizationId String
  runId          String
  stepId         String
  stepType       String
  name           String?
  status         WorkflowRunStatus @default(PENDING)
  /// Which execution adapter ran it (internal, n8n, make, rest).
  adapter        String?
  input          Json              @default("{}")
  output         Json?
  error          String?
  attempts       Int               @default(0)
  costUsd        Float             @default(0)
  durationMs     Int               @default(0)
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([runId])
  @@map("workflow_step_runs")
}

/// Something that starts a workflow: a domain event, an inbound webhook, or a
/// schedule.
model Trigger {
  id             String      @id @default(cuid())
  organizationId String
  workflowId     String
  name           String
  type           TriggerType
  enabled        Boolean     @default(true)

  /// Domain event name for EVENT triggers.
  eventName       String?
  /// Cron expression for SCHEDULE triggers.
  cron            String?
  /// Fixed interval alternative to cron, in seconds.
  intervalSeconds Int?
  /// Random path segment for WEBHOOK triggers — unguessable by design.
  webhookPath     String? @unique
  /// HMAC secret for verifying inbound webhook signatures.
  webhookSecret   String?

  /// Optional predicate over the event/webhook payload.
  conditions   Json @default("{}")
  /// Maps the incoming payload onto workflow inputs.
  inputMapping Json @default("{}")

  lastFiredAt DateTime?
  nextRunAt   DateTime?
  fireCount   Int       @default(0)
  failCount   Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, type, enabled])
  @@index([nextRunAt])
  @@map("triggers")
}

/// A decision a human must make before a suspended run continues.
model ApprovalRequest {
  id              String         @id @default(cuid())
  organizationId  String
  runId           String?
  stepId          String?
  title           String
  reason          String
  /// What the system would do if approved.
  suggestedAction String?
  context         Json           @default("{}")
  riskLevel       RiskLevel      @default(MEDIUM)
  status          ApprovalStatus @default(PENDING)

  requestedById String?
  decidedById   String?
  /// Set when delegated to someone else.
  delegatedToId String?
  decision      String?
  comment       String?

  expiresAt DateTime?
  decidedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          WorkflowRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("approval_requests")
}

/// A notification, recorded whether or not a channel delivered it.
model Notification {
  id             String               @id @default(cuid())
  organizationId String
  userId         String?
  category       String
  severity       NotificationSeverity @default(INFO)
  subject        String
  body           String
  /// Channels attempted, with per-channel outcome.
  deliveries     Json                 @default("[]")
  metadata       Json                 @default("{}")
  readAt         DateTime?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, readAt])
  @@map("notifications")
}

/// An API key for programmatic access.
///
/// Only a hash is stored; the plaintext is shown once at creation and is
/// unrecoverable afterwards.
model ApiKey {
  id                 String    @id @default(cuid())
  organizationId     String
  name               String
  /// SHA-256 of the full key. Lookup is by `prefix`, verification by hash.
  keyHash            String    @unique
  /// First characters, stored plainly so a key can be identified in a list.
  prefix             String
  scopes             String[]  @default([])
  rateLimitPerMinute Int       @default(120)
  lastUsedAt         DateTime?
  requestCount       Int       @default(0)
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())

  /// The developer app this key belongs to, when it was issued through the
  /// developer portal rather than the organization's own settings.
  developerAppId String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  developerApp DeveloperApp? @relation(fields: [developerAppId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([prefix])
  @@index([developerAppId])
  @@map("api_keys")
}

/// An outbound webhook subscription.
model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  url            String
  /// Domain events that trigger a delivery.
  events         String[] @default([])
  /// Signing secret; deliveries carry an HMAC of the body.
  secret         String
  enabled        Boolean  @default(true)
  maxRetries     Int      @default(5)

  /// Consecutive failures. Past a threshold the endpoint is disabled so a dead
  /// URL stops consuming delivery capacity.
  failureStreak Int       @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String         @id @default(cuid())
  organizationId String
  endpointId     String
  eventName      String
  payload        Json           @default("{}")
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  responseStatus Int?
  responseBody   String?
  error          String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([endpointId, status])
  @@map("webhook_deliveries")
}

/// Work that exhausted its retries. Nothing fails silently — it lands here.
model DeadLetter {
  id             String    @id @default(cuid())
  organizationId String
  source         String
  reference      String?
  reason         String
  payload        Json      @default("{}")
  attempts       Int       @default(0)
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, resolvedAt])
  @@map("dead_letters")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  /// Suspended awaiting a human decision.
  AWAITING_APPROVAL
  /// Suspended until a delay elapses.
  SLEEPING
  SUCCEEDED
  FAILED
  CANCELLED
  /// Retries exhausted; moved to the dead-letter queue.
  DEAD_LETTERED
  SKIPPED
}

enum TriggerType {
  MANUAL
  EVENT
  WEBHOOK
  SCHEDULE
  API
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  DELEGATED
  EXPIRED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  EXHAUSTED
}

enum IntegrationCategory {
  CRM
  EMAIL
  MESSAGING
  CALENDAR
  DATABASE
  CLOUD_STORAGE
  SOCIAL_MEDIA
  PAYMENT
  AUTOMATION
  CUSTOM_API
}

// ------------------------------------------------------------
// Phase 4: distributed intelligence
//
// A "node" is any machine PRISM-X may execute on: the control plane's own
// process, a home server, a rented VPS, a GPU box, a Raspberry Pi. The
// control plane stays the single source of truth — nodes hold no authority
// of their own, they are capacity. Everything below is tenant-scoped like
// the rest of the schema; a node belongs to exactly one organization and is
// only reachable by another organization through an explicit FederationGrant.
// ------------------------------------------------------------

/// One machine in the fleet.
///
/// Hardware and capability columns are *reported* by the node during
/// registration and refreshed on every heartbeat — they are inputs to
/// scheduling, not configuration a human maintains by hand. Registering a
/// node is the whole of "adding capacity": discovery, measurement and
/// rescheduling follow from the heartbeat stream.
model Node {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  /// Stable handle used in APIs and logs. Unique per organization.
  slug           String
  type           NodeType   @default(CUSTOM)
  status         NodeStatus @default(PENDING)

  /// Where the control plane reaches this node's agent API. Null for the
  /// control plane's own in-process node, which needs no network hop.
  endpointUrl String?
  /// True for the node this process is running as. Exactly one per org.
  isLocal     Boolean  @default(false)
  region      String   @default("default")
  /// Agent build reported at registration; used to gate protocol features.
  version     String?
  /// Free-form scheduling hints, e.g. "gpu", "eu-west", "cheap".
  labels      String[] @default([])

  // --- Reported hardware -------------------------------------------
  cpuCores    Int     @default(0)
  cpuModel    String?
  memoryMb    Int     @default(0)
  diskMb      Int     @default(0)
  gpuCount    Int     @default(0)
  gpuModel    String?
  gpuMemoryMb Int     @default(0)

  // --- Live load and health ----------------------------------------
  /// Ceiling on concurrently leased tasks. The scheduler will not exceed it.
  maxConcurrency Int   @default(4)
  activeTasks    Int   @default(0)
  queueDepth     Int   @default(0)
  cpuUsage       Float @default(0)
  memoryUsage    Float @default(0)
  diskUsage      Float @default(0)
  gpuUsage       Float @default(0)
  uptimeSeconds  Int   @default(0)
  /// Exponential moving average of round-trip latency in milliseconds.
  latencyMs      Float @default(0)
  /// 0..1, derived on every heartbeat. The scheduler's primary signal.
  healthScore    Float @default(0)
  /// Operator-supplied running cost, used to break ties toward cheap capacity.
  costPerHourUsd Float @default(0)

  lastHeartbeatAt DateTime?
  lastSeenIp      String?
  registeredAt    DateTime  @default(now())

  // --- Security and lifecycle --------------------------------------
  trust                NodeTrust @default(UNVERIFIED)
  /// Current signing key version. Older versions stay valid while retiring
  /// so a rotation does not knock a running node offline mid-task.
  keyVersion           Int       @default(1)
  allowRemoteExecution Boolean   @default(true)
  /// Set when an operator drains a node; scheduling stops, running work finishes.
  drainReason          String?
  consecutiveFailures  Int       @default(0)
  quarantinedUntil     DateTime?
  metadata             Json      @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  heartbeats   NodeHeartbeat[]
  capabilities NodeCapability[]
  keys         NodeKey[]
  tasks        DistributedTask[]
  shards       MemoryShard[]
  syncStates   NodeSyncState[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastHeartbeatAt])
  @@map("nodes")
}

/// What a node can actually run, discovered rather than declared.
///
/// The scheduler will not place work on a node that has not advertised the
/// provider, tool or extension the work needs, which is what makes
/// "register a node and it joins the fleet" safe: capability comes from the
/// node, so an under-equipped machine simply never wins a placement.
model NodeCapability {
  id             String         @id @default(cuid())
  organizationId String
  nodeId         String
  kind           CapabilityKind
  /// Provider kind, tool key, extension slug or runtime identifier.
  key            String
  name           String?
  version        String?
  available      Boolean        @default(true)
  detail         Json           @default("{}")
  discoveredAt   DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, kind, key])
  @@index([organizationId])
  @@index([organizationId, kind, key])
  @@map("node_capabilities")
}

/// Append-only telemetry. One row per heartbeat, kept for the monitoring
/// dashboard's time series and for post-mortem on a node that failed.
model NodeHeartbeat {
  id             String     @id @default(cuid())
  organizationId String
  nodeId         String
  status         NodeStatus
  cpuUsage       Float      @default(0)
  memoryUsage    Float      @default(0)
  diskUsage      Float      @default(0)
  gpuUsage       Float      @default(0)
  activeTasks    Int        @default(0)
  queueDepth     Int        @default(0)
  latencyMs      Float      @default(0)
  uptimeSeconds  Int        @default(0)
  healthScore    Float      @default(0)
  details        Json       @default("{}")
  reportedAt     DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([nodeId, reportedAt])
  @@map("node_heartbeats")
}

/// A node's shared secret, versioned so rotation can overlap.
///
/// Unlike ApiKey, which stores only a hash, this keeps the secret itself —
/// sealed with AES-256-GCM under CREDENTIAL_ENCRYPTION_KEY. Authentication
/// here is mutual and signature-based: the control plane must be able to
/// *produce* an HMAC for outbound calls, not merely compare an inbound
/// bearer token, and that requires the key material. `secretHash` is kept
/// alongside for constant-time equality checks that do not need decryption.
model NodeKey {
  id             String        @id @default(cuid())
  organizationId String
  nodeId         String
  version        Int
  secretHash     String
  secretCipher   String        @default("")
  secretIv       String        @default("")
  secretTag      String        @default("")
  status         NodeKeyStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  /// While a key is RETIRING it still verifies, until this moment passes.
  retiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([organizationId])
  @@map("node_keys")
}

/// A unit of work the fleet owns, independent of which node runs it.
///
/// The queue a task sits in (`queue`) and its lifecycle state (`status`) are
/// separate on purpose: the four queues are the operator's mental model,
/// while status drives the coordinator. A task can move between nodes any
/// number of times without changing identity, which is what makes failover
/// and rebalancing observable rather than magical.
model DistributedTask {
  id             String                @id @default(cuid())
  organizationId String
  /// Dispatch key, e.g. "worker.execute", "tool.invoke", "workflow.step".
  kind           String
  queue          DistributedQueue      @default(INCOMING)
  status         DistributedTaskStatus @default(QUEUED)
  priority       Priority              @default(MEDIUM)

  payload      Json    @default("{}")
  /// Hardware/provider/label constraints the scheduler must satisfy.
  requirements Json    @default("{}")
  result       Json?
  error        String?

  /// Assigned node. Null while the task is waiting for a placement.
  nodeId         String?
  /// Where the task entered the fleet, for provenance across migrations.
  originNodeId   String?
  /// Node it ran on before the most recent migration, if any.
  previousNodeId String?
  migrations     Int     @default(0)

  attempts       Int     @default(0)
  maxAttempts    Int     @default(3)
  /// Caller-supplied dedupe key. Re-submitting the same key returns the
  /// original task instead of running the work twice.
  idempotencyKey String?

  /// A lease is a promise a node made to finish this task. When it expires
  /// without a result the coordinator assumes the node is gone and reassigns.
  leaseExpiresAt DateTime?
  /// Retry backoff gate: the task is invisible to the scheduler until then.
  availableAt    DateTime  @default(now())

  workerId      String?
  missionId     String?
  taskId        String?
  workflowRunId String?

  queuedAt    DateTime  @default(now())
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  costUsd     Float     @default(0)
  totalTokens Int       @default(0)
  metadata    Json      @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         Node?        @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, queue])
  @@index([organizationId, status, availableAt])
  @@index([nodeId, status])
  @@map("distributed_tasks")
}

/// A versioned key/value record replicated across the fleet.
///
/// Four scopes, from narrowest to widest: LOCAL belongs to one node, SHARED
/// is replicated to every node in the organization, CACHED is a node-local
/// copy of a shared record that may be stale, and GLOBAL is org-wide state
/// the control plane owns. Conflicts are resolved by version then by
/// last-writer timestamp, with the losing write kept in the op log so a
/// human can see what was discarded.
model MemoryShard {
  id             String      @id @default(cuid())
  organizationId String
  scope          MemoryScope @default(LOCAL)
  namespace      String      @default("default")
  key            String
  /// Empty string — not NULL — for scopes that are not node-specific. A
  /// nullable column here would break the unique index below, because
  /// Postgres treats NULLs as distinct and every write would insert a new
  /// row instead of updating the existing one (same reasoning as
  /// `usage_daily`'s slice keys).
  nodeId         String      @default("")

  value       Json   @default("{}")
  version     Int    @default(1)
  /// SHA-256 of the canonical value, so a sync can detect drift without
  /// shipping the whole payload.
  checksum    String @default("")
  /// Per-node counters. Detects concurrent divergent writes that a single
  /// version number would silently collapse.
  vectorClock Json   @default("{}")

  ownerNodeId      String?
  lastWriterNodeId String?
  tags             String[]  @default([])
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Tombstone. Deletes must replicate, so the row survives the delete.
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        Node?        @relation(fields: [ownerNodeId], references: [id], onDelete: SetNull)

  @@unique([organizationId, scope, namespace, nodeId, key])
  @@index([organizationId])
  @@index([organizationId, scope, updatedAt])
  @@map("memory_shards")
}

/// The replication log. Every write to a shard appends one op.
///
/// This is simultaneously the incremental-sync feed (a node pulls ops after
/// its cursor), the offline queue (ops a disconnected node has not applied
/// stay PENDING) and the conflict record.
model MemorySyncOp {
  id             String       @id @default(cuid())
  organizationId String
  /// Monotonic within the database. Sync cursors are expressed in terms of it.
  sequence       Int          @default(autoincrement())
  shardId        String?
  scope          MemoryScope
  namespace      String       @default("default")
  key            String
  op             SyncOpKind
  payload        Json         @default("{}")
  version        Int          @default(1)
  /// Node that produced the write.
  nodeId         String       @default("")
  status         SyncOpStatus @default(PENDING)
  /// Set on a losing write: the op that won, and why.
  conflictWithId String?
  resolution     String?
  appliedAt      DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([sequence])
  @@index([organizationId])
  @@index([organizationId, sequence])
  @@index([organizationId, status])
  @@map("memory_sync_ops")
}

/// How far through the replication log a node has read, per scope.
model NodeSyncState {
  id             String      @id @default(cuid())
  organizationId String
  nodeId         String
  scope          MemoryScope
  lastSequence   Int         @default(0)
  lastSyncAt     DateTime?
  pendingOps     Int         @default(0)
  /// Set while a node is catching up after being offline.
  recovering     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, scope])
  @@index([organizationId])
  @@map("node_sync_states")
}

/// Explicit, revocable permission for one organization to use another's
/// resources.
///
/// There is no implicit federation anywhere in the system: absent an ACTIVE
/// grant naming a resource, a cross-organization request is refused. A grant
/// is one-directional — mutual sharing is two grants.
model FederationGrant {
  id                 String           @id @default(cuid())
  /// The organization that owns the resources and issues the grant.
  organizationId     String
  /// The organization being granted access.
  peerOrganizationId String
  name               String?
  status             FederationStatus @default(PENDING)
  /// Enumerated capabilities, e.g. "nodes:execute", "memory:read".
  /// Empty means nothing is shared, which is also the default.
  resources          String[]         @default([])
  /// Narrows the grant to specific nodes. Empty means every eligible node.
  allowedNodeIds     String[]         @default([])
  /// Ceiling on simultaneous borrowed tasks, so a peer cannot starve the owner.
  maxConcurrentTasks Int              @default(1)
  activeTasks        Int              @default(0)
  expiresAt          DateTime?
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdById        String?
  revokedById        String?
  terms              Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation("FederationOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  peer         Organization @relation("FederationPeer", fields: [peerOrganizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, peerOrganizationId])
  @@index([organizationId])
  @@index([peerOrganizationId, status])
  @@map("federation_grants")
}

enum NodeType {
  LOCAL_MACHINE
  HOME_SERVER
  CLOUD_VPS
  DEDICATED_AI_SERVER
  EDGE_DEVICE
  DEVELOPMENT_MACHINE
  /// Escape hatch for machine classes that do not exist yet. New types are
  /// added here rather than encoded in labels.
  CUSTOM
}

enum NodeStatus {
  /// Registered but has not completed its first heartbeat.
  PENDING
  ONLINE
  /// Reachable but unhealthy — deprioritised, not excluded.
  DEGRADED
  OFFLINE
  /// Operator-initiated: finish current work, accept nothing new.
  DRAINING
  /// Repeated failures; excluded from scheduling until the hold expires.
  QUARANTINED
  DECOMMISSIONED
}

enum NodeTrust {
  UNVERIFIED
  TRUSTED
  REVOKED
}

enum NodeKeyStatus {
  ACTIVE
  RETIRING
  REVOKED
}

enum CapabilityKind {
  PROVIDER
  MODEL
  TOOL
  EXTENSION
  RUNTIME
  HARDWARE
}

enum DistributedQueue {
  INCOMING
  ACTIVE
  COMPLETED
  FAILED
}

enum DistributedTaskStatus {
  QUEUED
  ASSIGNED
  RUNNING
  SUCCEEDED
  FAILED
  /// Retries exhausted or no node could ever satisfy the requirements.
  DEAD_LETTERED
  CANCELLED
  /// Being moved to another node; briefly neither running nor queued.
  MIGRATING
}

enum MemoryScope {
  LOCAL
  SHARED
  CACHED
  GLOBAL
}

enum SyncOpKind {
  PUT
  DELETE
}

enum SyncOpStatus {
  PENDING
  APPLIED
  CONFLICT
  SUPERSEDED
  FAILED
}

enum FederationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

// ------------------------------------------------------------
// Phase 5: learning and optimization
//
// The tables below are the system's memory *of itself*: what it did, how
// well it went, what that implies, and what it proposes doing differently.
// They are deliberately separate from operational knowledge — a mission
// review is not a document a worker should retrieve mid-task, and mixing
// the two would let the system's opinions about its own performance leak
// into the answers it gives users.
//
// Every table that carries a claim also carries `confidence` and
// `sampleSize`. See src/learning/confidence.ts for why: a finding drawn
// from three missions and one drawn from five hundred must not be
// indistinguishable at the point of reading.
// ------------------------------------------------------------

/// A structured post-mortem, written automatically when a mission ends.
///
/// One per mission, permanently. The mission itself may be archived or its
/// tasks pruned; the review is what survives, and it is the unit the rest of
/// the Learning Engine reasons over.
model MissionReview {
  id             String @id @default(cuid())
  organizationId String
  missionId      String @unique

  objective    String
  outcome      ReviewOutcome
  /// 0..1. Derived from task completion, retries, errors and budget
  /// adherence — not from anyone's opinion.
  successScore Float         @default(0)

  completionMs     Int    @default(0)
  /// Planner's estimate at the time, kept so drift is measurable.
  estimatedMs      Int?
  costUsd          Float  @default(0)
  estimatedCostUsd Float?
  totalTokens      Int    @default(0)

  taskCount      Int @default(0)
  tasksSucceeded Int @default(0)
  tasksFailed    Int @default(0)
  retryCount     Int @default(0)

  /// How much a person had to step in: approvals answered, manual retries.
  humanInterventions Int   @default(0)
  humanMinutes       Float @default(0)

  /// Error signatures encountered, deduplicated.
  errors              String[] @default([])
  /// Steps that took disproportionately long, with their share of the total.
  bottlenecks         Json     @default("[]")
  /// Things that could have been done and were not — unused parallelism,
  /// skipped knowledge, cheaper providers that were available.
  missedOpportunities Json     @default("[]")
  /// Improvements proposed off the back of this one mission.
  recommendations     Json     @default("[]")

  /// Free-text summary, searchable.
  summary    String
  tags       String[] @default([])
  confidence Float    @default(0)
  sampleSize Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, outcome])
  @@index([organizationId, createdAt])
  @@map("mission_reviews")
}

/// A metric rollup for one subject over one period.
///
/// Trends are derived by comparing snapshots rather than by storing a
/// "trend" column, because a trend is a relationship between measurements
/// and storing it would let it drift out of agreement with the measurements
/// it claims to summarise.
model PerformanceSnapshot {
  id             String        @id @default(cuid())
  organizationId String
  subject        MetricSubject
  /// Worker/provider/workflow id, or the organization id for org-level rows.
  subjectId      String
  subjectLabel   String        @default("")
  period         MetricPeriod  @default(DAY)
  /// Start of the period. With `period` this is the natural key.
  periodStart    DateTime

  /// Attempts observed in the window. The denominator for every rate here.
  samples      Int   @default(0)
  successes    Int   @default(0)
  failures     Int   @default(0)
  /// Wilson lower bound of the success rate, not the raw proportion —
  /// see confidence.ts for why a 3-for-3 record must not outrank 480-for-500.
  successRate  Float @default(0)
  observedRate Float @default(0)

  avgDurationMs  Float @default(0)
  p95DurationMs  Float @default(0)
  avgCostUsd     Float @default(0)
  totalCostUsd   Float @default(0)
  totalTokens    Int   @default(0)
  avgLatencyMs   Float @default(0)
  retryRate      Float @default(0)
  errorRate      Float @default(0)
  /// 0..1 composite, meaningful only within a subject type.
  qualityScore   Float @default(0)
  /// Work completed per dollar. Zero when nothing was spent.
  costEfficiency Float @default(0)

  /// Subject-specific extras: automation coverage, spend by provider, etc.
  detail     Json  @default("{}")
  confidence Float @default(0)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, subject, subjectId, period, periodStart])
  @@index([organizationId])
  @@index([organizationId, subject, periodStart])
  @@map("performance_snapshots")
}

/// Something the system thinks should change.
///
/// A recommendation is inert. It carries a proposed change and the means to
/// undo it, but applying it is a separate, human-gated act — see the
/// `status` lifecycle and the human validation layer.
model Recommendation {
  id             String             @id @default(cuid())
  organizationId String
  kind           RecommendationKind
  subject        MetricSubject
  subjectId      String
  subjectLabel   String             @default("")

  title     String
  /// Why the system believes this, in plain language.
  reasoning String
  /// The numbers behind it, so a reader can check the reasoning.
  evidence  Json   @default("{}")

  /// 0..1 estimated benefit, and the same in readable terms.
  estimatedImpact Float     @default(0)
  impactSummary   String    @default("")
  risk            RiskLevel @default(LOW)
  riskNotes       String?

  /// The change itself, as data. Applying it is the validation layer's job.
  proposedChange Json @default("{}")
  /// What to restore to undo it. Captured at propose time, not apply time,
  /// so a recommendation is never approvable without a way back.
  rollback       Json @default("{}")

  confidence Float @default(0)
  sampleSize Int   @default(0)
  /// estimatedImpact × confidence. Ranking on impact alone promotes
  /// confident nonsense; this is the column the list is sorted by.
  priority   Float @default(0)

  status          RecommendationStatus @default(PROPOSED)
  decidedById     String?
  decidedAt       DateTime?
  decisionNotes   String?
  appliedAt       DateTime?
  rolledBackAt    DateTime?
  /// State captured immediately before applying, for a faithful rollback.
  appliedSnapshot Json?

  /// Set when this supersedes an earlier recommendation about the same thing.
  supersedesId String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status, priority])
  @@index([organizationId, subject, subjectId])
  @@map("recommendations")
}

/// What the system has learned about one worker.
///
/// Rebuilt from execution history rather than edited, and never applied to
/// the worker automatically: the profile is an observation, the worker's
/// configuration is a decision.
model WorkerProfile {
  id             String @id @default(cuid())
  organizationId String
  workerId       String @unique

  preferredProviderId String?
  preferredModel      String?
  /// Why that provider won, kept so the choice can be argued with.
  preferenceEvidence  Json    @default("{}")

  executions      Int   @default(0)
  successes       Int   @default(0)
  /// Wilson lower bound, as everywhere else.
  successRate     Float @default(0)
  avgQuality      Float @default(0)
  avgCostUsd      Float @default(0)
  avgDurationMs   Float @default(0)
  avgTokens       Int   @default(0)
  toolCallCount   Int   @default(0)
  toolDenialCount Int   @default(0)

  /// Prompt shape that correlated with the best outcomes.
  bestPromptStyle String?
  /// Recurring failure signatures with counts.
  failureTypes    Json     @default("[]")
  strengths       String[] @default([])
  weaknesses      String[] @default([])

  confidence     Float     @default(0)
  lastAnalyzedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker       Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("worker_profiles")
}

/// A regularity observed across many missions.
///
/// Distinct from a Recommendation: a pattern is a claim about what *is*, a
/// recommendation is a proposal about what to *do*. Patterns accumulate
/// support over time and are re-scored as evidence arrives, which is why
/// `occurrences` and `lastObservedAt` are updated in place rather than a new
/// row being written for every sighting.
model DetectedPattern {
  id             String      @id @default(cuid())
  organizationId String
  kind           PatternKind
  /// Stable identity for the regularity, so repeat sightings reinforce one
  /// row instead of accumulating near-duplicates.
  signature      String

  statement   String
  detail      Json     @default("{}")
  /// Ids of the missions, workers or runs this was observed in.
  evidenceIds String[] @default([])

  occurrences    Int    @default(1)
  contradictions Int    @default(0)
  confidence     Float  @default(0)
  /// ANECDOTAL / EMERGING / ESTABLISHED / STRONG, denormalised for filtering.
  band           String @default("ANECDOTAL")

  firstObservedAt DateTime  @default(now())
  lastObservedAt  DateTime  @default(now())
  /// Set when a human says the pattern is wrong; it stops being surfaced
  /// but is kept, because a rejected pattern is itself information.
  dismissedAt     DateTime?
  dismissedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, signature])
  @@index([organizationId])
  @@index([organizationId, kind, confidence])
  @@map("detected_patterns")
}

/// The learning repository: institutional memory, separate from operational
/// knowledge.
///
/// Its purpose is improvement, not retrieval during work. Nothing here is
/// fed to a worker as context — that separation is the whole point, because
/// a system's notes about its own weaknesses have no business appearing in
/// an answer to a customer's question.
model LearningEntry {
  id             String            @id @default(cuid())
  organizationId String
  kind           LearningEntryKind
  title          String
  body           String
  /// Links back to whatever produced this: review, recommendation, pattern.
  sourceType     String?
  sourceId       String?
  data           Json              @default("{}")
  tags           String[]          @default([])

  confidence     Float     @default(0)
  sampleSize     Int       @default(0)
  /// Set when a later entry replaces this one's conclusion.
  supersededById String?
  supersededAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, kind, createdAt])
  @@map("learning_entries")
}

/// A quality finding about one knowledge document.
///
/// Findings are proposals, never edits. Merging two documents or deleting a
/// stale one destroys information, so both stay behind a human decision.
model KnowledgeAudit {
  id             String           @id @default(cuid())
  organizationId String
  knowledgeId    String
  finding        KnowledgeFinding
  /// The other document involved, for duplicates and merges.
  relatedId      String?
  /// 0..1 textual similarity where relevant.
  similarity     Float?
  detail         String
  suggestion     String
  confidence     Float            @default(0)

  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?
  createdAt    DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledge    Knowledge    @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, finding, resolvedAt])
  @@map("knowledge_audits")
}

/// An A/B test between two workflow versions.
///
/// Allocation is deterministic per run, and a winner is only declared when
/// the two arms separate beyond their margins of error — an experiment that
/// stops at the first favourable number is worse than no experiment, because
/// it lends noise the authority of a measurement.
model Experiment {
  id             String @id @default(cuid())
  organizationId String
  workflowId     String
  name           String
  hypothesis     String

  controlVersionId String
  variantVersionId String
  /// 0..1 share of runs sent to the variant.
  allocation       Float  @default(0.5)

  controlRuns       Int   @default(0)
  controlSuccesses  Int   @default(0)
  controlDurationMs Float @default(0)
  controlCostUsd    Float @default(0)

  variantRuns       Int   @default(0)
  variantSuccesses  Int   @default(0)
  variantDurationMs Float @default(0)
  variantCostUsd    Float @default(0)

  status     ExperimentStatus @default(RUNNING)
  /// "control", "variant" or null while undecided.
  winner     String?
  confidence Float            @default(0)
  conclusion String?

  /// Minimum runs per arm before a winner may be declared at all.
  minRunsPerArm Int @default(20)

  startedAt   DateTime  @default(now())
  concludedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("experiments")
}

enum ReviewOutcome {
  SUCCESS
  PARTIAL
  FAILURE
  CANCELLED
}

enum MetricSubject {
  WORKER
  PROVIDER
  WORKFLOW
  ORGANIZATION
  MISSION
}

enum MetricPeriod {
  HOUR
  DAY
  WEEK
  MONTH
}

enum RecommendationKind {
  /// Point a worker at a different provider or model.
  PROVIDER_SWITCH
  MODEL_SWITCH
  /// Rewrite or restructure a worker's standing instructions.
  PROMPT_REFINEMENT
  /// Grant or revoke tool access.
  TOOL_PERMISSION
  /// Adjust memory limits, retrieval depth or iteration caps.
  MEMORY_TUNING
  LIMIT_ADJUSTMENT
  /// Structural change to a workflow graph.
  WORKFLOW_STRUCTURE
  /// Remove a step that never changes an outcome.
  WORKFLOW_PRUNE
  /// Run independent steps concurrently.
  WORKFLOW_PARALLELISE
  /// Insert a missing approval or guard.
  WORKFLOW_GUARD
  KNOWLEDGE_MERGE
  KNOWLEDGE_REFRESH
  KNOWLEDGE_GAP
  COST_THRESHOLD
  CAPACITY
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  APPLIED
  ROLLED_BACK
  /// Superseded by a newer recommendation, or its evidence went stale.
  EXPIRED
}

enum PatternKind {
  PROVIDER_AFFINITY
  WORKER_COLLABORATION
  FAILURE_MODE
  TIMING
  COST
  TEMPLATE_PERFORMANCE
  DOMAIN_STYLE
  ROI
}

enum LearningEntryKind {
  MISSION_REVIEW
  OPTIMIZATION
  PERFORMANCE_TREND
  DECISION
  BENCHMARK
  AB_TEST
  LESSON
}

enum KnowledgeFinding {
  DUPLICATE
  NEAR_DUPLICATE
  OUTDATED
  UNUSED
  MERGE_CANDIDATE
  MISCATEGORISED
  GAP
  LOW_CONFIDENCE
}

enum ExperimentStatus {
  RUNNING
  CONCLUDED
  ABANDONED
}

// ------------------------------------------------------------
// Phase 6: the Evolution Engine
//
// Where Phase 5 observes and proposes, Phase 6 tests and deploys. The
// governing idea is that no change reaches production without having been
// measured against what it replaces, and no deployment exists without the
// state needed to undo it.
//
// The PRISM-X Constitution (src/evolution/constitution.ts) is deliberately
// NOT modelled here. Laws that live in a table are laws the system could
// evolve; these live in code, and amending one requires a review and a
// deploy. `ConstitutionViolation` below records refusals — it does not
// define the rules.
// ------------------------------------------------------------

/// A proposed change, before anything has been tested.
///
/// Distinct from a Phase 5 Recommendation: a recommendation is advice for a
/// human ("this worker would do better on Sonnet"), while a candidate is a
/// concrete change queued for measurement. Recommendations that recur are
/// promoted into candidates; candidates that lose their experiment are
/// rejected without a human ever having to read them.
model EvolutionCandidate {
  id             String           @id @default(cuid())
  organizationId String
  kind           EvolutionKind
  subject        EvolutionSubject
  subjectId      String
  subjectLabel   String           @default("")

  description     String
  reason          String
  expectedBenefit String
  /// 0..1, carried over from the evidence that produced it.
  confidence      Float           @default(0)
  sampleSize      Int             @default(0)
  risk            RiskLevel       @default(LOW)
  status          CandidateStatus @default(DRAFT)

  /// The change itself and the state to restore. A candidate without a
  /// rollback can never be deployed — see the REVERSIBILITY law.
  proposedChange Json @default("{}")
  rollback       Json @default("{}")

  /// Phase 5 recommendation this was promoted from, when there was one.
  sourceRecommendationId String?
  /// Times this same change has been proposed. Repeated proposals are
  /// evidence that the opportunity is real and persistent.
  proposalCount          Int     @default(1)

  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  experiments  EvolutionExperiment[]
  deployments  Deployment[]

  @@unique([organizationId, kind, subjectId, status])
  @@index([organizationId])
  @@index([organizationId, status, confidence])
  @@map("evolution_candidates")
}

/// A controlled test of one candidate against what it would replace.
///
/// Four modes, and the difference between them is what the candidate is
/// allowed to touch: SANDBOX touches nothing real, SHADOW runs alongside
/// production without its results being used, CANARY takes a small share of
/// real traffic, and AB splits traffic evenly. They are ordered by risk, and
/// the policy layer decides which an organization permits.
model EvolutionExperiment {
  id             String                    @id @default(cuid())
  organizationId String
  candidateId    String
  mode           ExperimentMode            @default(SANDBOX)
  status         EvolutionExperimentStatus @default(RUNNING)

  name       String
  hypothesis String

  /// Version records for the two arms. Control is what production runs now.
  controlVersionId String?
  variantVersionId String?
  /// 0..1 share of trials given to the candidate. Ignored for SHADOW, where
  /// the candidate sees everything and affects nothing.
  allocation       Float   @default(0.5)

  controlTrials   Int @default(0)
  variantTrials   Int @default(0)
  /// Trials each arm needs before a winner may be declared at all.
  minTrialsPerArm Int @default(10)

  /// "control", "variant", or null while undecided.
  winner     String?
  confidence Float             @default(0)
  verdict    BenchmarkVerdict?
  conclusion String?

  startedAt   DateTime  @default(now())
  concludedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    EvolutionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  benchmarks   Benchmark[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([candidateId])
  @@map("evolution_experiments")
}

/// Measured performance of one arm of one experiment.
///
/// Nine metrics, recorded per arm rather than as a single "score", because
/// collapsing them early hides the trade-offs that make a decision
/// interesting — a variant that is faster and worse is a different situation
/// from one that is faster and cheaper.
model Benchmark {
  id             String @id @default(cuid())
  organizationId String
  experimentId   String
  /// "control" or "variant".
  arm            String

  trials       Int   @default(0)
  successes    Int   @default(0)
  /// Wilson lower bound, as everywhere else in the platform.
  successRate  Float @default(0)
  observedRate Float @default(0)

  avgCompletionMs Float  @default(0)
  p95CompletionMs Float  @default(0)
  qualityScore    Float  @default(0)
  avgCostUsd      Float  @default(0)
  totalCostUsd    Float  @default(0)
  avgTokens       Float  @default(0)
  avgLatencyMs    Float  @default(0)
  /// Share of trials that neither failed nor needed a retry.
  reliability     Float  @default(0)
  /// Mean human rating, when any were given. Null means nobody rated it —
  /// which is not the same as a rating of zero.
  userRating      Float?
  ratingCount     Int    @default(0)
  /// Successes per dollar. Zero spend leaves this at zero rather than
  /// infinite, so a free arm does not win every efficiency comparison.
  roi             Float  @default(0)

  detail    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  experiment   EvolutionExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, arm])
  @@index([organizationId])
  @@map("benchmarks")
}

/// One immutable version of an evolvable thing.
///
/// Versions are never edited and never deleted — a new one supersedes its
/// predecessor. That is what makes rollback a matter of re-activating an
/// existing row rather than reconstructing a past state from a diff, and it
/// is why the NO_AUTOMATIC_DELETION law can be absolute.
model EntityVersion {
  id             String           @id @default(cuid())
  organizationId String
  subject        EvolutionSubject
  subjectId      String
  /// What aspect this version captures: PROMPT, MODEL, TOOLS, MEMORY,
  /// GRAPH or STRATEGY. One subject has independent lineages per aspect.
  aspect         VersionAspect
  version        Int

  /// The values this version sets, and what it replaced.
  payload  Json @default("{}")
  previous Json @default("{}")

  label       String?
  notes       String?
  /// Exactly one version per (subject, subjectId, aspect) is active.
  isActive    Boolean       @default(false)
  /// Where this version came from: a human edit, a candidate, a rollback.
  origin      VersionOrigin @default(MANUAL)
  candidateId String?
  /// Benchmark that justified promoting it, when it came through one.
  benchmarkId String?

  activatedAt  DateTime?
  supersededAt DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deployments  Deployment[]

  @@unique([organizationId, subject, subjectId, aspect, version])
  @@index([organizationId])
  @@index([organizationId, subject, subjectId, aspect])
  @@map("entity_versions")
}

/// A change that actually reached production, and everything about it.
///
/// The deployment row is the audit record the AUDITABILITY law requires. It
/// is written before the change is applied, not after, so a deployment that
/// crashes mid-write is still visible rather than invisible.
model Deployment {
  id             String           @id @default(cuid())
  organizationId String
  candidateId    String?
  versionId      String?
  subject        EvolutionSubject
  subjectId      String
  subjectLabel   String           @default("")
  kind           EvolutionKind

  status   DeploymentStatus @default(PENDING)
  /// Exact field-level change written, and the state captured immediately
  /// before writing it.
  applied  Json             @default("{}")
  rollback Json             @default("{}")

  /// Constitution decision recorded at deploy time, including the hash of
  /// the constitution in force. A refusal is kept as a deployment row with
  /// status REFUSED, because attempts matter as much as successes.
  constitutionVersion String  @default("")
  constitutionPassed  Boolean @default(false)
  lawVerdicts         Json    @default("[]")

  policySatisfied Boolean   @default(false)
  policyReason    String?
  approvedById    String?
  approvedAt      DateTime?
  deployedById    String?

  /// Post-deployment watch. A deployment is not finished when it is applied,
  /// it is finished when it has survived a window of real use.
  monitorUntil      DateTime?
  monitoredTrials   Int       @default(0)
  monitoredFailures Int       @default(0)
  healthy           Boolean?

  rolledBackAt   DateTime?
  rolledBackById String?
  rollbackReason String?
  /// True when the system rolled itself back rather than a person doing it.
  automatic      Boolean   @default(false)

  benchmarkSummary Json      @default("{}")
  notes            String?
  deployedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    EvolutionCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  version      EntityVersion?      @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, subject, subjectId])
  @@map("deployments")
}

/// An organization's own limits on how it is allowed to change.
///
/// The Constitution is the floor and cannot be lowered; the policy is each
/// organization's ceiling and can be as restrictive as it likes. One row per
/// organization, created with conservative defaults on first access rather
/// than requiring setup — an organization that has never configured
/// evolution should not thereby be evolving freely.
model EvolutionPolicy {
  id             String @id @default(cuid())
  organizationId String @unique

  /// Master switch. Off means candidates and experiments still run; only
  /// deployment is blocked.
  enabled Boolean @default(true)

  /// Change kinds this organization permits at all. Empty means none.
  allowedKinds    EvolutionKind[]  @default([])
  /// Kinds that always need a person, whatever the confidence.
  requireApproval EvolutionKind[]  @default([])
  /// Experiment modes permitted. SANDBOX is always allowed.
  allowedModes    ExperimentMode[] @default([])

  /// Confidence below which nothing deploys unattended.
  autoApproveThreshold Float     @default(0.95)
  /// Risk above which a person is always required.
  maxUnattendedRisk    RiskLevel @default(LOW)
  /// Trials each arm needs before a candidate may be promoted.
  minTrialsPerArm      Int       @default(10)

  /// Restrict deployment to a daily window, in UTC hours. Null disables the
  /// restriction rather than meaning midnight.
  businessHoursStart Int?
  businessHoursEnd   Int?
  /// Days of week deployment is permitted, 0 = Sunday. Empty means any day.
  businessDays       Int[] @default([])

  maxConcurrentExperiments Int @default(3)
  /// Deployments permitted per rolling day. Zero disables the cap.
  maxDeploymentsPerDay     Int @default(5)

  /// Minutes a deployment is watched before being considered settled.
  monitorWindowMinutes  Int     @default(60)
  /// Failure rate during monitoring that triggers an automatic rollback.
  autoRollbackThreshold Float   @default(0.3)
  autoRollbackEnabled   Boolean @default(true)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("evolution_policies")
}

/// A refused deployment, kept permanently.
///
/// An engine that repeatedly proposes illegal changes is telling you
/// something about itself, and that signal only exists if refusals are
/// recorded rather than merely returned.
model ConstitutionViolation {
  id             String @id @default(cuid())
  organizationId String
  lawId          String
  reason         String

  subject             EvolutionSubject
  subjectId           String
  kind                EvolutionKind
  candidateId         String?
  deploymentId        String?
  /// The intent as submitted, so a refusal can be understood later.
  intent              Json             @default("{}")
  constitutionVersion String           @default("")
  actorId             String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, lawId, createdAt])
  @@map("constitution_violations")
}

/// A versioned approach to planning missions.
///
/// Planning is the one part of the system that decides how *other* parts
/// will be used, so improving it compounds. Strategies are compared on the
/// missions they produced rather than on their own description.
model PlanningStrategy {
  id             String @id @default(cuid())
  organizationId String
  name           String
  version        Int    @default(1)
  description    String

  /// Ordered heuristics: how tasks are sequenced, how workers are chosen,
  /// how providers are picked, how much parallelism is attempted.
  rules    Json    @default("{}")
  isActive Boolean @default(false)

  missionsPlanned    Int   @default(0)
  successes          Int   @default(0)
  successRate        Float @default(0)
  avgCompletionMs    Float @default(0)
  avgCostUsd         Float @default(0)
  avgTasksPerMission Float @default(0)
  confidence         Float @default(0)

  derivedFromId String?
  createdById   String?
  activatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("planning_strategies")
}

enum EvolutionKind {
  PROMPT_OPTIMIZATION
  MODEL_CHANGE
  PROVIDER_CHANGE
  TOOL_PERMISSION
  MEMORY_STRATEGY
  EXECUTION_LIMITS
  WORKFLOW_STRUCTURE
  WORKFLOW_PARALLELISM
  WORKFLOW_SIMPLIFICATION
  MISSION_TEMPLATE
  PLANNING_STRATEGY
}

enum EvolutionSubject {
  WORKER
  WORKFLOW
  PROVIDER
  PLANNING
  ORGANIZATION
}

enum CandidateStatus {
  DRAFT
  /// Queued for an experiment.
  QUEUED
  TESTING
  /// The experiment found it better; awaiting approval or deployment.
  VALIDATED
  DEPLOYED
  /// The experiment found it no better, or worse.
  REJECTED
  /// Superseded by a newer candidate for the same change.
  SUPERSEDED
}

enum ExperimentMode {
  /// Runs entirely off production data. Touches nothing real.
  SANDBOX
  /// Runs alongside production; results recorded, never used.
  SHADOW
  /// A small share of real traffic.
  CANARY
  /// An even split of real traffic.
  AB
}

enum EvolutionExperimentStatus {
  RUNNING
  CONCLUDED
  ABANDONED
}

enum BenchmarkVerdict {
  BETTER
  WORSE
  /// Measured, but the arms cannot be told apart.
  INCONCLUSIVE
  /// Not enough trials yet to say anything.
  INSUFFICIENT_DATA
}

enum DeploymentStatus {
  PENDING
  /// Refused by the Constitution or the policy; never applied.
  REFUSED
  DEPLOYED
  MONITORING
  /// Survived its monitoring window.
  SETTLED
  ROLLED_BACK
  FAILED
}

enum VersionAspect {
  PROMPT
  MODEL
  TOOLS
  MEMORY
  LIMITS
  GRAPH
  STRATEGY
}

enum VersionOrigin {
  MANUAL
  CANDIDATE
  ROLLBACK
  IMPORT
}

// ============================================================
// Phase 7 — Platform & Extensibility Ecosystem
//
// Everything hosted by PRISM-X — extensions, contributed workers, contributed
// tools, marketplace assets — is described by the same vocabulary: capabilities.
// The platform never asks what *kind* of thing a component is; it asks which
// capabilities it holds, and every guarded surface reads that one answer.
//
// Scope note. Most tables here are tenant-scoped and carry RLS like every
// other phase. Five are deliberately global — publishers, listings, listing
// versions, advisories and governance reviews — because a catalogue everyone
// installs from cannot be partitioned by tenant without ceasing to be a
// catalogue. Those get a different policy shape: readable by all, writable
// only by the organization that owns the row. See the Phase 7 RLS migration.
// ============================================================

enum CapabilityRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// The lifecycle an extension moves through, one value per transition the
/// platform performs. Recording the phase rather than only the resulting
/// status is what makes a failed install diagnosable after the fact.
enum ExtensionPhase {
  INSTALL
  VALIDATE
  REGISTER
  INITIALIZE
  RUN
  UPDATE
  MIGRATE
  DISABLE
  ENABLE
  QUARANTINE
  ROLLBACK
  UNINSTALL
}

enum LifecycleOutcome {
  STARTED
  SUCCEEDED
  FAILED
  /// Refused by policy — missing capability, failed signature, blocked upgrade.
  REFUSED
}

enum ContributionKind {
  WORKER
  TOOL
  TRIGGER
}

/// What the sandbox decided about a single host call.
enum SandboxDecision {
  ALLOWED
  /// Capability not held, or the method is not part of the API at all.
  DENIED
  /// Allowed, then the extension's own code failed.
  FAILED
  /// Allowed, but over its rate limit or past its timeout.
  THROTTLED
}

/// The ten kinds of asset the marketplace carries.
enum MarketplaceAssetKind {
  EXTENSION
  WORKER
  TOOL
  WORKFLOW
  CONNECTOR
  TRIGGER
  KNOWLEDGE_PACK
  PROMPT_PACK
  DASHBOARD
  POLICY
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  /// Pulled by moderation. Existing installs keep working; new ones are blocked.
  SUSPENDED
  /// Still installable, but the publisher has signalled it is going away.
  DEPRECATED
}

enum PublisherTrust {
  UNVERIFIED
  VERIFIED
  PARTNER
  OFFICIAL
}

enum AdvisorySeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum GovernanceReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum GovernanceSubject {
  LISTING_VERSION
  PUBLISHER
  ADVISORY
}

enum UpgradeOutcome {
  PENDING
  /// Impossible or incoherent — a downgrade, an engine mismatch, a bad version.
  BLOCKED
  /// Possible, but changes the deal the operator agreed to.
  AWAITING_CONSENT
  APPLIED
  FAILED
  ROLLED_BACK
}

// ------------------------------------------------------------
// Extension runtime
// ------------------------------------------------------------

/// One row per lifecycle transition attempted on an extension.
model ExtensionLifecycleEvent {
  id             String           @id @default(cuid())
  organizationId String
  extensionId    String
  phase          ExtensionPhase
  outcome        LifecycleOutcome
  fromStatus     ExtensionStatus?
  toStatus       ExtensionStatus?
  version        String?
  /// Phase-specific detail: validation errors, granted capabilities, the
  /// upgrade analysis. Bounded before it is written.
  detail         Json             @default("{}")
  message        String?
  durationMs     Int?
  actorId        String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  extension    Extension    @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@index([organizationId, extensionId, createdAt])
  @@index([organizationId, phase, outcome])
  @@map("extension_lifecycle_events")
}

/// A worker type, tool or trigger an extension contributed to the platform.
///
/// Contributions are registered rather than executed at install time, so the
/// catalogue is knowable without running anything, and a disabled extension's
/// contributions disappear from every lookup in one update.
model ExtensionContribution {
  id             String           @id @default(cuid())
  organizationId String
  extensionId    String
  kind           ContributionKind
  /// Namespaced at registration as `<extension-slug>.<declared key>`, so two
  /// extensions can contribute a tool called `search` without colliding.
  key            String
  name           String
  description    String?
  definition     Json             @default("{}")
  /// The slice of the extension's grant this contribution runs under. Always a
  /// subset — attenuation can narrow, never widen.
  capabilities   String[]         @default([])
  enabled        Boolean          @default(true)
  /// Worker row materialised for WORKER contributions.
  workerId       String?
  /// Trigger row materialised for TRIGGER contributions.
  triggerId      String?
  invocations    Int              @default(0)
  failures       Int              @default(0)
  lastInvokedAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  extension    Extension    @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, key])
  @@index([organizationId, extensionId])
  @@index([organizationId, kind, enabled])
  @@map("extension_contributions")
}

/// An extension's private keyspace.
///
/// Partitioned by extension, so `can_persist_state` borrows no organization
/// permission: an extension reading its own settings is not reading anything
/// that belonged to anyone else.
model ExtensionState {
  id             String   @id @default(cuid())
  organizationId String
  extensionId    String
  key            String
  value          Json
  /// Serialised size, summed to enforce the storage ceiling without a scan.
  bytes          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  extension    Extension    @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([extensionId, key])
  @@index([organizationId, extensionId])
  @@map("extension_state")
}

/// Every call an extension made into the host, allowed or not.
///
/// Denials matter more than successes here: an extension repeatedly reaching
/// for a capability it was not granted is the signal that it is doing
/// something other than what its listing said.
model ExtensionHostCall {
  id             String          @id @default(cuid())
  organizationId String
  extensionId    String
  method         String
  capability     String?
  decision       SandboxDecision
  reason         String?
  durationMs     Int             @default(0)
  /// Bounded snapshot of the arguments — enough to diagnose, not enough to
  /// turn the audit log into a second copy of the data.
  argsPreview    Json            @default("{}")
  contributionId String?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  extension    Extension    @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@index([organizationId, extensionId, createdAt])
  @@index([organizationId, decision, createdAt])
  @@map("extension_host_calls")
}

/// An attempted version change, with the analysis that justified or blocked it.
///
/// The snapshot is what makes rollback a restore rather than a reinstall: the
/// previous manifest, config and grant are captured before anything is written.
model ExtensionUpgrade {
  id                  String         @id @default(cuid())
  organizationId      String
  extensionId         String
  fromVersion         String
  toVersion           String
  /// MAJOR, MINOR, PATCH or PRERELEASE.
  release             String         @default("PATCH")
  outcome             UpgradeOutcome @default(PENDING)
  breaking            Boolean        @default(false)
  blocked             Boolean        @default(false)
  /// The full `[{ severity, code, message }]` list from the analysis.
  changes             Json           @default("[]")
  addedCapabilities   String[]       @default([])
  removedCapabilities String[]       @default([])
  migrations          Json           @default("[]")
  /// Everything needed to put the old version back.
  snapshot            Json           @default("{}")
  consentedById       String?
  consentedAt         DateTime?
  appliedAt           DateTime?
  rolledBackAt        DateTime?
  error               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  extension    Extension    @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@index([organizationId, extensionId, createdAt])
  @@index([organizationId, outcome])
  @@map("extension_upgrades")
}

// ------------------------------------------------------------
// Marketplace — global catalogue, owner-write
// ------------------------------------------------------------

/// A publishing identity. Global: the same publisher appears identically to
/// every organization, which is the whole point of verification.
model Publisher {
  id                  String         @id @default(cuid())
  slug                String         @unique
  displayName         String
  /// The organization that controls this identity.
  ownerOrganizationId String
  contactEmail        String?
  website             String?
  trust               PublisherTrust @default(UNVERIFIED)
  verifiedAt          DateTime?
  verifiedById        String?
  /// Public material releases are verified against.
  signingKey          String?
  suspendedAt         DateTime?
  suspensionReason    String?
  listingCount        Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner      Organization         @relation(fields: [ownerOrganizationId], references: [id], onDelete: Cascade)
  listings   MarketplaceListing[]
  extensions Extension[]

  @@index([ownerOrganizationId])
  @@index([trust])
  @@map("publishers")
}

/// A marketplace entry. The mutable head; installable content lives in
/// versions, so a listing edit never changes what an existing install runs.
model MarketplaceListing {
  id                  String               @id @default(cuid())
  assetKind           MarketplaceAssetKind
  slug                String
  name                String
  summary             String
  description         String?
  publisherId         String
  ownerOrganizationId String
  license             String               @default("proprietary")
  homepage            String?
  documentation       String?
  tags                String[]             @default([])
  /// Highest published, non-yanked version.
  latestVersion       String               @default("0.0.0")
  /// Platform API range the latest version supports.
  compatibility       String               @default("*")
  /// Capabilities the latest version requests, denormalised so the catalogue
  /// can be filtered by risk without joining every version row.
  capabilities        String[]             @default([])
  riskLevel           CapabilityRiskLevel  @default(LOW)
  status              ListingStatus        @default(DRAFT)
  downloads           Int                  @default(0)
  installCount        Int                  @default(0)
  /// Sum and count rather than a stored average, so a new rating is one
  /// increment and the average is never drifting from its inputs.
  ratingSum           Int                  @default(0)
  ratingCount         Int                  @default(0)
  deprecatedAt        DateTime?
  deprecationNotice   String?
  supersededBySlug    String?
  suspendedAt         DateTime?
  suspensionReason    String?
  publishedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  publisher  Publisher            @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  versions   MarketplaceVersion[]
  reviews    MarketplaceReview[]
  advisories SecurityAdvisory[]
  installs   Extension[]

  @@unique([assetKind, slug])
  @@index([status, assetKind])
  @@index([publisherId])
  @@index([ownerOrganizationId])
  @@map("marketplace_listings")
}

/// One immutable release of a listing.
model MarketplaceVersion {
  id            String                 @id @default(cuid())
  listingId     String
  version       String
  manifest      Json                   @default("{}")
  /// sha256 of the security-relevant manifest fields.
  digest        String                 @default("")
  signature     String?
  signedBy      String?
  changelog     String?
  /// True when the analysis against the previous version found breaking changes.
  breaking      Boolean                @default(false)
  capabilities  String[]               @default([])
  riskLevel     CapabilityRiskLevel    @default(LOW)
  compatibility String                 @default("*")
  /// A yanked version stays visible to anyone already on it — so they can see
  /// why — but can never be newly installed.
  yankedAt      DateTime?
  yankReason    String?
  reviewStatus  GovernanceReviewStatus @default(PENDING)
  downloads     Int                    @default(0)
  publishedById String?
  publishedAt   DateTime               @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, version])
  @@index([listingId, publishedAt])
  @@map("marketplace_versions")
}

/// A published security advisory against a range of versions.
model SecurityAdvisory {
  id             String           @id @default(cuid())
  listingId      String?
  /// Kept as a slug too, so an advisory survives the listing being removed.
  affectedSlug   String
  severity       AdvisorySeverity
  title          String
  summary        String
  /// Semver range of affected versions.
  affectedRange  String
  patchedVersion String?
  reference      String?
  /// Organization that raised it. Advisories themselves are readable by all.
  raisedByOrgId  String?
  publishedById  String?
  publishedAt    DateTime         @default(now())
  withdrawnAt    DateTime?

  listing MarketplaceListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([affectedSlug])
  @@index([listingId])
  @@index([severity, publishedAt])
  @@map("security_advisories")
}

/// A moderation decision on a listing version, a publisher or an advisory.
model GovernanceReview {
  id               String                 @id @default(cuid())
  subject          GovernanceSubject
  subjectId        String
  /// Denormalised so the queue renders without a join per row.
  subjectLabel     String                 @default("")
  status           GovernanceReviewStatus @default(PENDING)
  /// Capabilities under review, and what the automated checks found.
  capabilities     String[]               @default([])
  riskLevel        CapabilityRiskLevel    @default(LOW)
  findings         Json                   @default("[]")
  notes            String?
  reviewerId       String?
  requestedById    String?
  /// Organization that submitted the subject, for attribution in the queue.
  requestedByOrgId String?
  decidedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([subject, subjectId])
  @@map("governance_reviews")
}

/// An organization's rating of a listing. Tenant-scoped: the aggregate on the
/// listing is public, the individual review belongs to whoever wrote it.
model MarketplaceReview {
  id             String    @id @default(cuid())
  organizationId String
  listingId      String
  /// 1 to 5.
  rating         Int
  title          String?
  body           String?
  /// The version being rated, so a fixed complaint is identifiable as stale.
  version        String?
  authorId       String?
  /// Hidden by moderation and excluded from the aggregate; the row is kept so
  /// the decision is auditable rather than a silent deletion.
  hiddenAt       DateTime?
  hiddenReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([organizationId, listingId])
  @@index([listingId])
  @@map("marketplace_reviews")
}

// ------------------------------------------------------------
// Developer portal
// ------------------------------------------------------------

/// A registered integration built against the public API.
model DeveloperApp {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  homepage       String?
  /// Publisher identity this app publishes marketplace assets under.
  publisherId    String?
  /// Where the platform calls back to.
  webhookUrl     String?
  /// Sealed. Deliveries carry an HMAC computed with it.
  webhookSecret  String?
  enabled        Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("developer_apps")
}

/// Daily public-API usage, rolled up per app, key and endpoint.
///
/// `appId` and `apiKeyId` are plain columns rather than foreign keys: the slice
/// keys use an empty-string sentinel (see below), which no foreign key could
/// satisfy, and a usage row should outlive the key that produced it anyway.
model DeveloperApiUsage {
  id              String   @id @default(cuid())
  organizationId  String
  /// Empty string rather than NULL for both slice keys: Postgres treats NULLs
  /// as distinct in a unique index, so a nullable slice would accumulate a new
  /// duplicate row on every increment instead of updating one.
  appId           String   @default("")
  apiKeyId        String   @default("")
  day             DateTime @db.Date
  endpoint        String   @default("")
  requests        Int      @default(0)
  errors          Int      @default(0)
  throttled       Int      @default(0)
  totalDurationMs Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, appId, apiKeyId, day, endpoint])
  @@index([organizationId, day])
  @@map("developer_api_usage")
}

// ============================================================
// Phase 8 — Production & Enterprise Operating System
//
// Three scopes appear here, and the distinction is the point:
//
//   Tenant tables — subscriptions, invoices, sessions, allowlists, compliance
//   reports. The usual contract: RLS keyed on the acting organization.
//
//   Catalogue — `plans`. Readable by everyone, writable by nobody through a
//   constrained client. A customer must be able to see what they can buy.
//
//   Operator tables — instances, backups, restores, alerts, rotations,
//   deployments, readiness reviews. These describe the platform, not a
//   tenant, and no tenant client has any business reading them. They get RLS
//   enabled with *no* policies at all, which denies every constrained session
//   by default. The backend's own trusted connection is the only way in.
// ============================================================

enum DeploymentEnvironment {
  DEVELOPMENT
  TEST
  STAGING
  PRODUCTION
}

enum InstanceStatus {
  STARTING
  HEALTHY
  DRAINING
  /// Missed its heartbeat window. Work it held is reclaimable.
  UNREACHABLE
  STOPPED
}

enum BackupKind {
  DATABASE
  STORAGE
  CONFIGURATION
}

enum BackupStatus {
  RUNNING
  SUCCEEDED
  FAILED
  /// Read back and checked against its own checksum.
  VERIFIED
  /// Read back and found not to match. Worse than no backup, so it is loud.
  CORRUPT
  EXPIRED
}

enum RestoreMode {
  FULL
  POINT_IN_TIME
  /// Reads and validates without writing anything.
  VERIFY_ONLY
}

enum RestoreStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum MfaMethod {
  TOTP
  RECOVERY_CODE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  FIRING
  RESOLVED
  ACKNOWLEDGED
}

enum RotationScope {
  CREDENTIAL_KEY
  API_KEY
  WEBHOOK_SECRET
  NODE_KEY
}

enum RotationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  /// Old and new material both accepted while callers migrate.
  OVERLAPPING
}

enum ReleaseStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

enum ComplianceReportKind {
  ACCESS_REVIEW
  DATA_INVENTORY
  AUDIT_SUMMARY
  RETENTION
  SECURITY_POSTURE
}

// ------------------------------------------------------------
// Operator tables — platform state, invisible to tenant clients
// ------------------------------------------------------------

/// One row per running backend process.
///
/// The leader lease lives here rather than only in Redis so that "who is
/// running the schedules" survives a cache flush and is answerable from the
/// same place as everything else about an instance.
model Instance {
  id              String                @id @default(cuid())
  /// Stable per process. Regenerated on restart — a restarted process is a
  /// new instance, because anything it held is gone.
  instanceId      String                @unique
  hostname        String
  environment     DeploymentEnvironment @default(DEVELOPMENT)
  version         String                @default("0.0.0")
  status          InstanceStatus        @default(STARTING)
  pid             Int?
  startedAt       DateTime              @default(now())
  lastHeartbeat   DateTime              @default(now())
  /// Sampled at heartbeat. Enough to spot a sick instance, not a profiler.
  cpuPercent      Float                 @default(0)
  memoryMb        Float                 @default(0)
  activeRequests  Int                   @default(0)
  handledRequests BigInt                @default(0)
  /// Held by at most one instance. Scheduled work runs only for the holder.
  leaderUntil     DateTime?
  stoppedAt       DateTime?
  updatedAt       DateTime              @updatedAt

  @@index([status, lastHeartbeat])
  @@index([leaderUntil])
  @@map("instances")
}

/// A stored backup.
model Backup {
  id                 String                @id @default(cuid())
  kind               BackupKind
  status             BackupStatus          @default(RUNNING)
  environment        DeploymentEnvironment @default(DEVELOPMENT)
  /// Where the artefact lives, through the storage driver.
  location           String                @default("")
  sizeBytes          Int                   @default(0)
  /// sha256 of the plaintext, recorded before encryption so verification
  /// checks the data rather than the ciphertext.
  checksum           String                @default("")
  encrypted          Boolean               @default(false)
  /// Sealed data key. Never the key itself.
  keyMaterial        Json                  @default("{}")
  /// Tables and row counts captured, for a restore to check against.
  manifest           Json                  @default("{}")
  startedAt          DateTime              @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  error              String?
  verifiedAt         DateTime?
  verificationDetail String?
  /// Deleted after this. A backup with no retention is a storage bill.
  retentionUntil     DateTime?
  createdById        String?

  restores RestoreRun[]

  @@index([kind, status, startedAt])
  @@index([retentionUntil])
  @@map("backups")
}

/// An attempt to read a backup back, whether or not it wrote anything.
model RestoreRun {
  id             String        @id @default(cuid())
  backupId       String
  mode           RestoreMode   @default(VERIFY_ONLY)
  status         RestoreStatus @default(RUNNING)
  /// For POINT_IN_TIME: the moment being restored to.
  targetTime     DateTime?
  /// True when the restore validated everything and wrote nothing.
  dryRun         Boolean       @default(true)
  tablesRestored Int           @default(0)
  rowsRestored   Int           @default(0)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  error          String?
  detail         Json          @default("{}")
  runById        String?

  backup Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId, startedAt])
  @@map("restore_runs")
}

/// A monitoring rule. Platform-level: these watch infrastructure, not tenants.
model AlertRule {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String?
  /// Metric name as exposed by the metrics registry.
  metric      String
  /// `gt`, `gte`, `lt`, `lte`.
  comparison  String        @default("gt")
  threshold   Float
  /// How long the condition must hold before firing.
  forSeconds  Int           @default(60)
  severity    AlertSeverity @default(WARNING)
  enabled     Boolean       @default(true)
  /// Notification channels to reach when this fires.
  channels    String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  events AlertEvent[]

  @@index([enabled, severity])
  @@map("alert_rules")
}

model AlertEvent {
  id               String        @id @default(cuid())
  ruleId           String
  ruleKey          String
  severity         AlertSeverity
  status           AlertStatus   @default(FIRING)
  /// The measurement that crossed the line, and the line.
  value            Float
  threshold        Float
  detail           String?
  firedAt          DateTime      @default(now())
  resolvedAt       DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([status, firedAt])
  @@index([ruleKey, firedAt])
  @@map("alert_events")
}

/// A secret rotation, recorded so "when did we last rotate" is answerable.
model SecretRotation {
  id            String         @id @default(cuid())
  scope         RotationScope
  status        RotationStatus @default(RUNNING)
  /// Identifier of the material now in use.
  newKeyId      String         @default("")
  previousKeyId String         @default("")
  itemsRotated  Int            @default(0)
  itemsFailed   Int            @default(0)
  /// While set, both old and new material verify — the migration window.
  overlapUntil  DateTime?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  error         String?
  actorId       String?

  @@index([scope, startedAt])
  @@map("secret_rotations")
}

/// A deployment, as recorded by the pipeline.
model Release {
  id                String                @id @default(cuid())
  environment       DeploymentEnvironment
  version           String
  commitSha         String                @default("")
  status            ReleaseStatus         @default(PENDING)
  /// The version this replaced, so a rollback knows where to go.
  previousVersion   String?
  /// Gate results: lint, typecheck, unit, integration, migration, security.
  checks            Json                  @default("[]")
  migrationsApplied Int                   @default(0)
  startedAt         DateTime              @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  error             String?
  /// Set on a rollback, pointing at what it undid.
  rollbackOfId      String?
  actorId           String?

  @@index([environment, startedAt])
  @@index([status])
  @@map("releases")
}

/// A recorded production readiness review.
model ReadinessReview {
  id           String                @id @default(cuid())
  environment  DeploymentEnvironment
  /// Fingerprint of the readiness bar the review ran against.
  version      String
  ready        Boolean               @default(false)
  score        Float                 @default(0)
  summary      Json                  @default("{}")
  /// Every verdict, kept whole — a summary that loses the failures is a slogan.
  verdicts     Json                  @default("[]")
  blockers     Int                   @default(0)
  reviewedById String?
  createdAt    DateTime              @default(now())

  @@index([environment, createdAt])
  @@map("readiness_reviews")
}

// ------------------------------------------------------------
// Billing — catalogue plus tenant subscriptions
// ------------------------------------------------------------

/// A subscription plan. Global catalogue: publicly readable, operator-written.
model Plan {
  key                     String          @id
  name                    String
  description             String?
  priceCents              Int             @default(0)
  currency                String          @default("usd")
  interval                BillingInterval @default(MONTHLY)
  seatsIncluded           Int             @default(1)
  /// Additional seats beyond `seatsIncluded`, per interval.
  seatPriceCents          Int             @default(0)
  /// Feature keys this plan unlocks. Gating reads this list.
  features                String[]        @default([])
  /// Hard ceilings: missions, workers, nodes, storage, AI spend.
  limits                  Json            @default("{}")
  trialDays               Int             @default(0)
  /// Cents charged per 1,000 AI tokens beyond what the plan includes.
  aiOveragePerKTokenCents Float           @default(0)
  includedKTokens         Int             @default(0)
  isPublic                Boolean         @default(true)
  active                  Boolean         @default(true)
  sortOrder               Int             @default(0)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  subscriptions Subscription[]

  @@index([active, sortOrder])
  @@map("plans")
}

/// One organization's subscription. At most one live at a time.
model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  planKey            String
  status             SubscriptionStatus @default(TRIALING)
  /// Seats purchased. Members beyond this are refused, not silently billed.
  seats              Int                @default(1)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  /// Identifier at whichever payment processor is wired up, when one is.
  externalRef        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planKey], references: [key])
  invoices     Invoice[]

  @@index([organizationId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  /// Human-facing, sequential per organization.
  number         String
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("usd")
  periodStart    DateTime
  periodEnd      DateTime
  /// Plan and seat charges.
  subtotalCents  Int           @default(0)
  /// Metered AI usage beyond what the plan includes.
  usageCents     Int           @default(0)
  totalCents     Int           @default(0)
  /// One entry per charge, with the numbers it was derived from.
  lines          Json          @default("[]")
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId, periodStart])
  @@index([status])
  @@map("invoices")
}

// ------------------------------------------------------------
// Security — sessions, second factors, network restrictions
// ------------------------------------------------------------

/// An authenticated session, so one can be ended without ending all of them.
model UserSession {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  /// sha256 of the issued token. The token itself is never stored.
  tokenHash      String    @unique
  ip             String?
  userAgent      String?
  /// True once a second factor has been presented for this session.
  mfaSatisfied   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// A user's second factor. Global, because a user is global.
model MfaEnrollment {
  id            String    @id @default(cuid())
  userId        String    @unique
  method        MfaMethod @default(TOTP)
  /// Sealed shared secret. Never returned after enrolment.
  secret        Json      @default("{}")
  /// sha256 of each single-use recovery code. Consumed codes are removed.
  recoveryCodes String[]  @default([])
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("mfa_enrollments")
}

/// A network restriction. Empty for an organization means no restriction.
model IpAllowEntry {
  id             String   @id @default(cuid())
  organizationId String
  /// IPv4 CIDR, or a single address.
  cidr           String
  label          String?
  enabled        Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, cidr])
  @@index([organizationId, enabled])
  @@map("ip_allow_entries")
}

/// A generated compliance report, kept so an auditor sees what was reported.
model ComplianceReport {
  id             String               @id @default(cuid())
  organizationId String
  kind           ComplianceReportKind
  periodStart    DateTime
  periodEnd      DateTime
  /// The report body. Kept whole so it can be re-read, not re-derived.
  findings       Json                 @default("{}")
  /// Counts that make a list of reports scannable without opening each one.
  summary        Json                 @default("{}")
  generatedById  String?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, createdAt])
  @@map("compliance_reports")
}
