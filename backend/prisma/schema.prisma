// ============================================================
// PRISM-X — Prisma schema (Backend Phase 1)
//
// Design rules:
//  * Every tenant-scoped model carries `organizationId` and is indexed on it.
//    This is the single anchor for both repository-level scoping and the
//    Postgres RLS policies in migrations/*_rls/migration.sql.
//  * No business logic lives here. Enums encode state machines only.
//  * Soft-delete (`deletedAt`) on entities users can remove but auditors
//    may still need to see.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Tenancy & identity
// ------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  plan      OrgPlan   @default(FREE)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships  Membership[]
  workers      Worker[]
  missions     Mission[]
  tasks        Task[]
  knowledge    Knowledge[]
  providers    Provider[]
  integrations Integration[]
  extensions   Extension[]
  events       Event[]
  auditLogs    AuditLog[]
  credentials  Credential[]
  roles        Role[]

  @@index([deletedAt])
  @@map("organizations")
}

/// A user is global (one identity across orgs); org access is via Membership.
/// `supabaseUserId` links to Supabase Auth when that provider is active;
/// `passwordHash` backs the local auth provider used in dev/test.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  displayName    String?
  avatarUrl      String?
  supabaseUserId String?   @unique
  passwordHash   String?
  emailVerified  Boolean   @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  memberships Membership[]
  auditLogs   AuditLog[]

  @@index([supabaseUserId])
  @@map("users")
}

/// Join table binding a User into an Organization with exactly one Role.
model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

// ------------------------------------------------------------
// RBAC
// ------------------------------------------------------------

/// System roles have `organizationId = null` and are seeded once
/// (OWNER/ADMIN/OPERATOR/VIEWER). Orgs may define additional custom roles.
model Role {
  id             String   @id @default(cuid())
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  Membership[]

  @@unique([key, organizationId])
  @@index([organizationId])
  @@map("roles")
}

/// Permissions are global constants shaped `resource:action`
/// (e.g. `mission:create`). Seeded, never user-created.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------
// Intelligence core
// ------------------------------------------------------------

model Worker {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  role           String
  status         WorkerStatus @default(DORMANT)
  dna            Json         @default("{}")
  capabilities   String[]     @default([])
  providerId     String?
  generation     Int          @default(1)
  fitness        Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  tasks        Task[]
  knowledge    Knowledge[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("workers")
}

model Mission {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  objective      String
  status         MissionStatus @default(DRAFT)
  priority       Priority      @default(MEDIUM)
  progress       Int           @default(0)
  metadata       Json          @default("{}")
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("missions")
}

/// A unit of work inside a Mission. `dependsOn` holds sibling task ids,
/// forming the mission DAG resolved by the queue layer.
model Task {
  id             String     @id @default(cuid())
  organizationId String
  missionId      String
  workerId       String?
  title          String
  description    String?
  status         TaskStatus @default(PENDING)
  priority       Priority   @default(MEDIUM)
  dependsOn      String[]   @default([])
  result         Json?
  error          String?
  attempts       Int        @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  worker       Worker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([missionId])
  @@index([organizationId, status])
  @@map("tasks")
}

model Knowledge {
  id             String        @id @default(cuid())
  organizationId String
  workerId       String?
  title          String
  content        String
  type           KnowledgeType @default(NOTE)
  tags           String[]      @default([])
  source         String?
  storagePath    String?
  confidence     Float         @default(1)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker       Worker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, type])
  @@map("knowledge")
}

// ------------------------------------------------------------
// External surface: providers, integrations, extensions
// ------------------------------------------------------------

/// An AI provider *registration*. Phase 1 stores configuration only —
/// no vendor SDK is wired. `kind` selects the adapter at resolve time.
model Provider {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  kind           ProviderKind
  status         ProviderStatus @default(DISCONNECTED)
  config         Json           @default("{}")
  credentialId   String?        @unique
  isDefault      Boolean        @default(false)
  lastCheckedAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential   Credential?  @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  workers      Worker[]

  @@index([organizationId])
  @@map("providers")
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  kind           String
  status         IntegrationStatus @default(INACTIVE)
  config         Json              @default("{}")
  credentialId   String?
  lastSyncAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("integrations")
}

model Extension {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  slug           String
  version        String          @default("1.0.0")
  status         ExtensionStatus @default(INSTALLED)
  manifest       Json            @default("{}")
  subscribes     String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("extensions")
}

// ------------------------------------------------------------
// Observability: events, audit, credentials
// ------------------------------------------------------------

/// Durable record of every domain event published on the bus.
/// Subscribers (extensions, analytics) replay from here.
model Event {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  payload        Json     @default("{}")
  actorId        String?
  correlationId  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([createdAt])
  @@map("events")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  ip             String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, resource])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Encrypted secret material (API keys, tokens). `value` is ciphertext
/// produced by the CryptoService — plaintext never reaches the database.
model Credential {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String
  value          String
  iv             String
  authTag        String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     Provider?

  @@index([organizationId])
  @@map("credentials")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WorkerStatus {
  DORMANT
  ACTIVE
  LEARNING
  NEEDS_ATTENTION
  ARCHIVED
}

enum MissionStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KnowledgeType {
  NOTE
  DOCUMENT
  INSIGHT
  PATTERN
  ARTIFACT
}

enum ProviderKind {
  OPENAI
  ANTHROPIC
  GEMINI
  HERMES
  LOCAL
  CUSTOM
}

enum ProviderStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum IntegrationStatus {
  INACTIVE
  ACTIVE
  ERROR
}

enum ExtensionStatus {
  INSTALLED
  ENABLED
  DISABLED
}
